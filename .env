# CalibreMCP Environment Configuration
# Copy this file to .env and update with your actual values

# Calibre Server Connection
CALIBRE_SERVER_URL=http://localhost:8186
CALIBRE_USERNAME=admin
CALIBRE_PASSWORD=!Aa781768544

# Library Configuration
# Option 1: Set a base path to auto-discover libraries as subdirectories
CALIBRE_BASE_PATH="E:\\A_Books\\Calibre书库\\轻小说"

# Option 2: Manually specify library paths as JSON
# CALIBRE_LIBRARY_PATHS={"main": "L:/Multimedia Files/Written Word/Calibre–Bibliothek", "it": "L:/Multimedia Files/Written Word/Calibre–Bibliothek IT", "japanese": "L:/Multimedia Files/Written Word/Calibre–Bibliothek Japanese", "manga": "L:/Multimedia Files/Written Word/Calibre–Bibliothek Manga"}

# Performance Settings  
CALIBRE_TIMEOUT=30
CALIBRE_MAX_RETRIES=3
CALIBRE_DEFAULT_LIMIT=50
CALIBRE_MAX_LIMIT=200

# Library Settings
CALIBRE_LIBRARY_NAME=轻小说

# Development/Debug Settings
CALIBRE_DEBUG=0
